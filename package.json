{
  "name": "vscode-3d-preview-true-origin",
  "publisher": "tyang-local",
  "displayName": "3D Viewer Light — True Origin",
  "description": "Preview meshes and point clouds with helpers at the true world origin and a selectable up-axis.",
  "version": "0.1.0",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "3d",
    "obj",
    "off",
    "pcd",
    "ply",
    "stl",
    "xyz",
    "mesh",
    "polygon",
    "point cloud",
    "point set",
    "viewer",
    "vscode"
  ],
  "activationEvents": [
    "onCustomEditor:trueOrigin3dPreview.viewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": true
      }
    },
    "customEditors": [
      {
        "viewType": "trueOrigin3dPreview.viewer",
        "displayName": "3D Viewer Light — True Origin",
        "selector": [
          {
            "filenamePattern": "*.obj"
          },
          {
            "filenamePattern": "*.stl"
          },
          {
            "filenamePattern": "*.off"
          },
          {
            "filenamePattern": "*.ply"
          },
          {
            "filenamePattern": "*.pcd"
          },
          {
            "filenamePattern": "*.xyz"
          }
        ]
      }
    ],
    "configuration": {
      "title": "3D Viewer Light — True Origin",
      "properties": {
        "trueOrigin3dPreview.hideControlsOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Fold the control panel if true is specified."
        },
        "trueOrigin3dPreview.showPoints": {
          "type": "boolean",
          "default": false,
          "description": "Show point cloud."
        },
        "trueOrigin3dPreview.showWireframe": {
          "type": "boolean",
          "default": false,
          "description": "Show wireframe."
        },
        "trueOrigin3dPreview.showMesh": {
          "type": "boolean",
          "default": true,
          "description": "Show mesh triangles."
        },
        "trueOrigin3dPreview.showGridHelper": {
          "type": "boolean",
          "default": true,
          "description": "Show grid helper."
        },
        "trueOrigin3dPreview.showAxesHelper": {
          "type": "boolean",
          "default": true,
          "description": "Show axes helper."
        },
        "trueOrigin3dPreview.upAxis": {
          "type": "string",
          "enum": [
            "x",
            "y",
            "z"
          ],
          "default": "z",
          "description": "World up-axis used to orient the camera and grid. Vertex coordinates are never transformed."
        },
        "trueOrigin3dPreview.backgroundColor": {
          "type": "string",
          "default": "#121212",
          "description": "Default background color."
        },
        "trueOrigin3dPreview.pointColor": {
          "type": "string",
          "default": "#cc0000",
          "description": "Default point color."
        },
        "trueOrigin3dPreview.pointSize": {
          "type": "number",
          "default": 0.5,
          "description": "Default point size."
        },
        "trueOrigin3dPreview.wireframeColor": {
          "type": "string",
          "default": "#0000ff",
          "description": "Default wireframe color."
        },
        "trueOrigin3dPreview.wireframeWidth": {
          "type": "number",
          "default": 0.5,
          "description": "Default wireframe width."
        },
        "trueOrigin3dPreview.fogDensity": {
          "type": "number",
          "default": 0,
          "description": "Fog density."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^11.0.1",
    "mocha": "^11.0.1",
    "tslint": "^6.1.3",
    "typescript": "^5.7.3",
    "vscode-test": "^1.6.1"
  }
}
